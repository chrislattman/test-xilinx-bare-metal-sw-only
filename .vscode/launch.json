{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Core A9#0 + A9#1 Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceRoot}/sw/hello_world/build/hello_world.elf",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb-multiarch",
            "miDebuggerArgs": "-q",
            "targetArchitecture": "arm",
            "customLaunchSetupCommands": [
                { "text": "set schedule-multiple off" },
                { "text": "file ${workspaceRoot}/sw/hello_world/build/hello_world.elf" },
                { "text": "target extended-remote localhost:3000" },
                { "text": "add-inferior" },
                { "text": "inferior 2" },
                { "text": "file ${workspaceRoot}/sw/hello_world_1/build/hello_world_1.elf" },
                { "text": "source ${workspaceRoot}/.vscode/a9_cores.gdb" },
                { "text": "attach 2" }
            ],
            "launchCompleteCommand": "None"
        },
        {
            "name": "QEMU A9#0 + A9#1 Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceRoot}/sw/hello_world/build/hello_world.elf",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb-multiarch",
            "miDebuggerArgs": "-q",
            "targetArchitecture": "arm",
            "customLaunchSetupCommands": [
                { "text": "file ${workspaceRoot}/sw/hello_world/build/hello_world.elf" },
                { "text": "add-symbol-file ${workspaceRoot}/sw/hello_world_1/build/hello_world_1.elf" },
                { "text": "target remote localhost:1234" },
                { "text": "set scheduler-locking step" }
            ],
            "launchCompleteCommand": "None"
        },
        {
            "name": "Rust: Core A9#0 + A9#1 Debug",
            "type": "gdb",
            "request": "attach",
            "target": "extended-remote localhost:3000",
            "executable": "${workspaceFolder}/sw/target/armv7a-none-eabihf/debug/hello-world-rs",
            "cwd": "${workspaceFolder}",
            "gdbpath": "${userHome}/.cargo/bin/rust-gdb",
            "env": {
                "RUST_GDB": "gdb-multiarch"
            },
            "stopAtConnect": true,
            "debugger_args": ["-iex", "python import gdb_load_rust_pretty_printers"],
            "autorun": [
                "set schedule-multiple off",
                "add-inferior",
                "inferior 2",
                "file ${workspaceFolder}/sw/target/armv7a-none-eabihf/debug/hello-world-1-rs",
                "python gdb.execute('attach 2')",
                "source ${workspaceFolder}/.vscode/a9_cores.gdb",
                "inferior 1"
            ]
        },
        {
            "name": "Rust: QEMU A9#0 + A9#1 Debug",
            "type": "gdb",
            "request": "attach",
            "remote": true,
            "target": "localhost:1234",
            "executable": "${workspaceFolder}/sw/target/armv7a-none-eabihf/debug/hello-world-rs",
            "cwd": "${workspaceFolder}",
            "gdbpath": "${userHome}/.cargo/bin/rust-gdb",
            "env": {
                "RUST_GDB": "gdb-multiarch"
            },
            "stopAtConnect": true,
            "debugger_args": ["-iex", "python import gdb_load_rust_pretty_printers"],
            "autorun": [
                "add-symbol-file ${workspaceFolder}/sw/target/armv7a-none-eabihf/debug/hello-world-1-rs",
                "set scheduler-locking step"
            ]
        }
    ]
}
